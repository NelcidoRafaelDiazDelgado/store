<% content_for :title, "Products" %>

<div class="w-full m-2">

  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-md inline-block">
      <%= notice %>
    </p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-3xl text-gray-900">Products</h1>

    <%= link_to "New product",
      new_product_path,
      class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <!-- Filters -->
  <%= form_with url: products_path,
                method: :get,
                local: true,
                class: "bg-white border border-gray-100 rounded-xl p-4 mb-5" do |form| %>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

      <!-- Search -->
      <div>
        <%= form.label :search, "Search",
          class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= form.text_field :search,
          value: params[:search],
          placeholder: "Search products...",
          class: "w-full rounded-md border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <!-- Limit -->
      <div>
        <%= form.label :limit, "Per page",
          class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= form.select :limit,
          options_for_select(
            [[10, 10], [20, 20], [50, 50], [100, 100]],
            params.fetch(:limit, 20)
          ),
          {},
          class: "w-full rounded-md border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <!-- Sort -->
      <div>
        <%= form.label :sort, "Sort by",
          class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= form.select :sort,
          options_for_select(
            [
              ["Created", "created_at"],
              ["Name", "name"],
              ["Price", "price"]
            ],
            params.fetch(:sort, "created_at")
          ),
          {},
          class: "w-full rounded-md border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <!-- Direction -->
      <div>
        <%= form.label :direction, "Direction",
          class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= form.select :direction,
          options_for_select(
            [
              ["Descending", "desc"],
              ["Ascending", "asc"]
            ],
            params.fetch(:direction, "desc")
          ),
          {},
          class: "w-full rounded-md border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

    </div>

    <div class="flex justify-end gap-2 mt-4">

      <%= link_to "Clear",
        products_path,
        class: "px-4 py-2 rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50" %>

      <%= form.submit "Filter",
        class: "px-4 py-2 rounded-md bg-blue-600 text-white font-medium hover:bg-blue-500" %>

    </div>

  <% end %>

  <!-- Table -->
  <div class="overflow-x-auto bg-white border border-gray-100 rounded-xl">

    <table class="min-w-full divide-y divide-gray-200">

      <thead class="bg-gray-50">
        <tr>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Product
          </th>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Price
          </th>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            SKU
          </th>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Stock
          </th>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Status
          </th>

          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">
            Actions
          </th>

        </tr>
      </thead>

      <tbody id="products" class="bg-white divide-y divide-gray-100">
        <%= render @products %>
      </tbody>

    </table>

    <div id="pagination" class="p-4 border-t border-gray-100">
      <%= render "pagination", pagy: @pagy %>
    </div>

  </div>

</div>

